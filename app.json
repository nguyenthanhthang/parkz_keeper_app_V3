{
  "expo": {
    "name": "Parkz Keeper",
    "displayName": "Parkz Keeper",
    "slug": "parkz-keeper-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#6200ee",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkz.keeper"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6200ee"
      },
      "package": "com.parkz.keeper"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép ứng dụng truy cập camera để quét mã QR."
        }
      ]
    ]
  }
}
